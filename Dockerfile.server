# Server Dockerfile
FROM node:22-alpine

WORKDIR /app

# 複製 package 文件
COPY package*.json ./

# 安裝生產依賴
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

# 複製後端相關文件
COPY server.js ./
COPY backend ./backend

ENV NODE_ENV=production
USER node

# 暴露端口
EXPOSE 3000

# 啟動 server
CMD ["node", "server.js"]
