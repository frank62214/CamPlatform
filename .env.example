# Run npm run auth:setup to create .env with a random signing key and a password hash.
# Node >=20.19.0 / >=22.12.0; .env is loaded only by npm run server:dev.
NODE_ENV=development
PORT=3000
DATA_ROOT=/data
CAMERA_IDS=cam1,cam2
AUTH_USERNAME=replace-with-your-username
AUTH_PASSWORD_HASH=generate-with-auth-setup
JWT_SECRET=generate-with-auth-setup
TOKEN_TTL_SECONDS=3600
COOKIE_SECURE=false
RECORDING_UTC_OFFSET=+08:00
# Optional for local dev; Vite preserves Host. Production requires HTTPS origin:
# PUBLIC_ORIGIN=https://nightwatch.hackdog.tw
# Behind Ingress, login rate limiting shares the actual proxy peer's quota.
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
